# Copy to .env to override the compose defaults. Placeholder values only.
POSTGRES_USER=listmate
POSTGRES_PASSWORD=change-me
# true = on an empty database, create alex@example.com and sam@example.com with two shared lists
LISTMATE_DEMO_DATA=false
# Password for both demo accounts (at least 8 characters, upper, lower, digit and symbol)
LISTMATE_DEMO_PASSWORD=
